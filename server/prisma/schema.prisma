generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  RESTRICTED
  BLOCKED
  DELETED
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum TrustLevel {
  NEW
  EMAIL_VERIFIED
  CONTACTS_VERIFIED
  VERIFIED_MEMBER
  TRUSTED_MEMBER
}

enum PropertyStatus {
  DRAFT
  PENDING_MODERATION
  PUBLISHED
  CHANGES_REQUESTED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  TOWNHOUSE
  COTTAGE
  OTHER
}

enum AvailabilityType {
  UNAVAILABLE
  POINTS
  DIRECT
  BOTH
  ON_REQUEST
}

enum PointTransactionType {
  BONUS
  RESERVE
  RELEASE
  DEBIT
  HOST_PENDING
  HOST_CREDIT
  REFUND
  COMPENSATION
  ADMIN_ADJUSTMENT
  EXPIRATION
  FREEZE
  UNFREEZE
}

enum VerificationType {
  EMAIL
  PHONE
  PASSWORD_RESET
}

enum FileProcessingStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  FAILED
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String?       @unique
  phone         String?       @unique
  passwordHash  String
  emailVerified Boolean       @default(false)
  phoneVerified Boolean       @default(false)
  status        AccountStatus @default(ACTIVE)
  role          UserRole      @default(USER)
  trustLevel    TrustLevel    @default(NEW)
  lastActiveAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  profile       UserProfile?
  sessions      UserSession[]
  properties    Property[]
  pointAccount  PointAccount?
  favorites     Favorite[]
  verifications ContactVerification[]
  moderationDecisions PropertyModerationDecision[]

  @@index([status, createdAt])
}

model UserProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  surname             String?
  patronymic          String?
  displayName         String
  avatarUrl           String?
  city                String?
  description         String?
  adultsCount         Int      @default(1)
  childrenCount       Int      @default(0)
  hasPets             Boolean  @default(false)
  interests           String[]
  travelPreferences   String[]
  hostRating          Decimal? @db.Decimal(2, 1)
  guestRating         Decimal? @db.Decimal(2, 1)
  completedExchanges  Int      @default(0)
  cancellationsCount  Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipHash           String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model ContactVerification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        VerificationType
  target      String
  codeHash    String
  expiresAt   DateTime
  verifiedAt  DateTime?
  attempts    Int              @default(0)
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([target, type])
}

model Property {
  id              String          @id @default(uuid()) @db.Uuid
  ownerId         String          @db.Uuid
  slug            String          @unique
  title           String          @default("Новое жильё")
  description     String          @default("")
  type            PropertyType    @default(OTHER)
  areaSqm         Int?
  roomsCount      Int?
  bedroomsCount   Int             @default(1)
  bedsCount       Int             @default(1)
  maxGuests       Int             @default(1)
  floor           Int?
  floorsTotal     Int?
  hasElevator     Boolean         @default(false)
  allowsChildren  Boolean         @default(true)
  allowsPets      Boolean         @default(false)
  hasPetsAtHome   Boolean         @default(false)
  requiresPetCare Boolean         @default(false)
  requiresPlantCare Boolean       @default(false)
  acceptsPoints   Boolean         @default(true)
  acceptsDirect   Boolean         @default(false)
  pointsPerNight  Int             @default(100)
  minNights       Int             @default(1)
  maxNights       Int?
  status          PropertyStatus  @default(DRAFT)
  isFake          Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  owner           User            @relation(fields: [ownerId], references: [id])
  address         PropertyAddress?
  photos          PropertyPhoto[]
  availability    AvailabilityPeriod[]
  favorites       Favorite[]
  rule            PropertyRule?
  amenities       PropertyAmenity[]
  moderationHistory PropertyModerationDecision[]

  @@index([status, createdAt])
  @@index([isFake, status, createdAt])
  @@index([ownerId, status])
}

model PropertyModerationDecision {
  id          String         @id @default(uuid()) @db.Uuid
  propertyId  String         @db.Uuid
  moderatorId String         @db.Uuid
  fromStatus  PropertyStatus
  toStatus    PropertyStatus
  comment     String?
  createdAt   DateTime       @default(now())
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  moderator   User           @relation(fields: [moderatorId], references: [id])

  @@index([propertyId, createdAt])
  @@index([moderatorId, createdAt])
}

model PropertyAddress {
  id                String   @id @default(uuid()) @db.Uuid
  propertyId        String   @unique @db.Uuid
  country           String
  region            String?
  city              String
  district          String?
  street            String?
  houseNumber       String?
  latitudeApprox    Decimal? @db.Decimal(9, 6)
  longitudeApprox   Decimal? @db.Decimal(9, 6)
  exactAddress      String?
  checkInInstructions String?
  keyHandoverInfo   String?
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([country, city, district])
}

model PropertyRule {
  id                  String   @id @default(uuid()) @db.Uuid
  propertyId          String   @unique @db.Uuid
  smokingAllowed      Boolean  @default(false)
  eventsAllowed       Boolean  @default(false)
  quietHoursStart     String?
  quietHoursEnd       String?
  additionalRules     String?
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Amenity {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  name        String
  category    String
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  properties  PropertyAmenity[]

  @@index([isActive, sortOrder])
}

model PropertyAmenity {
  propertyId String   @db.Uuid
  amenityId  String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model PropertyPhoto {
  id               String               @id @default(uuid()) @db.Uuid
  propertyId       String               @db.Uuid
  storageKey       String               @unique
  previewKey       String?
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  processingStatus FileProcessingStatus @default(PENDING_UPLOAD)
  processingError  String?
  externalUrl      String?
  sortOrder        Int                  @default(0)
  isPrimary        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  property         Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@index([processingStatus, createdAt])
}

model AvailabilityPeriod {
  id             String           @id @default(uuid()) @db.Uuid
  propertyId     String           @db.Uuid
  startsOn       DateTime         @db.Date
  endsOn         DateTime         @db.Date
  type           AvailabilityType
  minNights      Int              @default(1)
  maxNights      Int?
  pointsPerNight Int
  maxGuests      Int
  isFlexible     Boolean          @default(false)
  comment        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  property       Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startsOn, endsOn])
}

model Favorite {
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

model PointAccount {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @unique @db.Uuid
  available        BigInt             @default(0)
  reserved         BigInt             @default(0)
  pending          BigInt             @default(0)
  bonus            BigInt             @default(0)
  frozen           BigInt             @default(0)
  version          Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     PointTransaction[]

}

model PointTransaction {
  id             String               @id @default(uuid()) @db.Uuid
  accountId      String               @db.Uuid
  type           PointTransactionType
  amount         BigInt
  idempotencyKey String               @unique
  sourceType     String
  sourceId       String?
  description    String?
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  account        PointAccount         @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([sourceType, sourceId])
}
