APP_NAME=DomObmen
POINTS_NAME=ДомБаллы
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
INCLUDE_FAKE_PROPERTIES=false
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=change-me-before-use
DATABASE_URL=postgresql://domobmen:domobmen@localhost:5433/domobmen?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-different-characters
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
S3_BUCKET_PUBLIC=domobmen-public
S3_BUCKET_PRIVATE=domobmen-private
SMTP_HOST=localhost
SMTP_PORT=1025
SMS_PROVIDER=log
POINTS_WELCOME_BONUS=500
POINTS_EMAIL_VERIFICATION_BONUS=100
POINTS_PHONE_VERIFICATION_BONUS=200
POINTS_PROFILE_COMPLETION_BONUS=200
POINTS_HOST_REWARD_DELAY_HOURS=24
BONUS_EXPIRATION_DAYS=180
